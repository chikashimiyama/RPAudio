{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "PICO_SDK_PATH":"$env{USERPROFILE}/.pico-sdk/sdk/2.3.1",
                "picotool_DIR": "$env{USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool",
                "pioasm_DIR": "$env{USERPROFILE}/.pico-sdk/tools/2.3.1/pioasm"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "RPDSP_USB_DEBUG_LOG": "ON" }
        },
        {
            "name": "release",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "RPDSP_USB_DEBUG_LOG": "OFF" }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" }
    ]
}
